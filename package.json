{
  "name": "astro-james",
  "type": "module",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:sites:star": "astro build && node scripts/prepare-star-sites.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "memes:moderate": "node --experimental-strip-types --env-file-if-exists=.env scripts/meme-moderation/cli.mjs",
    "test:memes": "node --experimental-strip-types --test scripts/meme-moderation/*.test.mjs",
    "test:wordle": "node --test src/core/wordle/game.test.ts",
    "test:sro9": "node --experimental-strip-types --test src/helpers/timeHelpers.test.ts",
    "test:wavegame": "node --experimental-strip-types --test src/core/wavegame/logic.test.ts",
    "check:city-temperature": "tsc -p tsconfig.city-temperature.json",
    "test:city-temperature": "node --experimental-strip-types --test src/core/city-temperature/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "wordle:words": "node scripts/generate-wordle-words.mjs",
    "test:ms": "node microsoft.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/preact": "^6.0.1",
    "@astrojs/vercel": "^11.0.3",
    "@aws-sdk/client-polly": "^3.1089.0",
    "@neondatabase/serverless": "^1.0.0",
    "@preact/signals": "^1.3.0",
    "astro": "^7.1.0",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "fabric": "^6.7.1",
    "howler": "^2.2.4",
    "leaflet": "^1.9.4",
    "microsoft-cognitiveservices-speech-sdk": "^1.41.0",
    "preact": "^10.29.7",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "readline": "^1.3.0",
    "resend": "^4.0.1",
    "stream": "^0.0.3",
    "tone": "^15.1.22",
    "typescript": "^5.6.3",
    "vexflow": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.10"
  }
}
