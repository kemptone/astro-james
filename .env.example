# City Temperature Game account saving
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification and password recovery
RESEND_API_KEY=
AUTH_EMAIL_FROM=City Temperature Game <accounts@example.com>

# Payments are intentionally mocked right now; no Stripe variables are read.
# Future production checkout variables:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_HEATER_PRICE_ID=
# STRIPE_CONNECTIONS_PRICE_ID=
