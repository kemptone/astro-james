---
import {formatJavaLayers, parseLayers} from '../core/superflat/world'

const example = '-60 chicken'
const initialCode = formatJavaLayers(parseLayers(example))
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Superflat Layers</title>
  </head>
  <body>
    <main>
      <div class="field">
        <label for="layers">Custom layers</label>
        <textarea id="layers" rows="6" spellcheck="false" aria-describedby="layer-error">{example}</textarea>
      </div>
      <div class="field">
        <label for="java-layers">Java Edition layer code</label>
        <textarea id="java-layers" rows="6" spellcheck="false" aria-describedby="layer-error">{initialCode}</textarea>
      </div>
      <p id="layer-error" role="status"></p>
    </main>
  </body>
</html>

<script>
  import {formatJavaLayers, formatLayers, parseJavaLayers, parseLayers} from '../core/superflat/world'

  const layers = document.querySelector<HTMLTextAreaElement>('#layers')!
  const code = document.querySelector<HTMLTextAreaElement>('#java-layers')!
  const error = document.querySelector('#layer-error')!

  function convert(from: HTMLTextAreaElement, to: HTMLTextAreaElement, transform: (source: string) => string) {
    to.removeAttribute('aria-invalid')
    try {
      to.value = from.value.trim() ? transform(from.value) : ''
      from.removeAttribute('aria-invalid')
      error.textContent = ''
    } catch (cause) {
      to.value = ''
      from.setAttribute('aria-invalid', 'true')
      error.textContent = (cause as Error).message
    }
  }

  layers.addEventListener('input', () => convert(layers, code, source => formatJavaLayers(parseLayers(source))))
  code.addEventListener('input', () => convert(code, layers, source => formatLayers(parseJavaLayers(source))))
</script>

<style>
  body {
    margin: 0;
    background: #f5f4ec;
    color: #27362c;
    font: 1rem system-ui, sans-serif;
  }
  main {
    max-width: 52rem;
    margin: clamp(2rem, 10vh, 6rem) auto;
    padding-inline: 1rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  label {
    display: block;
    margin-bottom: .5rem;
    font-weight: 650;
  }
  textarea {
    box-sizing: border-box;
    display: block;
    width: 100%;
    resize: vertical;
    padding: .875rem;
    border: 1px solid #a4ae99;
    border-radius: .5rem;
    background: #fffef9;
    color: inherit;
    font: 1rem/1.5 ui-monospace, monospace;
  }
  textarea:focus-visible {
    outline: 2px solid #416143;
    outline-offset: 2px;
  }
  #layer-error {
    grid-column: 1 / -1;
    margin: 0;
    color: #8c382c;
    font-size: .875rem;
  }
  @media (max-width: 36rem) {
    main { grid-template-columns: 1fr; }
  }
</style>
