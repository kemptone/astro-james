---
import Menu from '@/components/menu.astro'
import DiscoverySetting from '@/components/DiscoverySetting'
import SettingsBuilder from '@/components/SettingsBuilder'
import '@/core/settings-builder/settings.css'
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#181d18" />
    <title>Settings Workshop</title>
  </head>
  <body class="workshop-page">
    <Menu />
    <main class="workshop">
      <header class="workshop-heading">
        <div class="workshop-icon" aria-hidden="true"><span></span></div>
        <div>
          <h1>Settings Workshop</h1>
          <p>Build your own groups, then try out the controls.</p>
        </div>
      </header>
      <SettingsBuilder client:load />
      <details class="app-settings">
        <summary>SRO25 Discovery Tour</summary>
        <div id="discovery-tour">
          <DiscoverySetting client:load />
          <a href="/sro25">Open SRO25</a>
        </div>
      </details>
    </main>
  </body>
</html>
