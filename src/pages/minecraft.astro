---
import Layout from '@/layouts/Layout.astro'
import {questionLimit} from '@/core/minecraft/chat'
import {openAISpeechVoices} from '@/core/openai/speech'

const starterQuestions = [
  'What should I do on my first night?',
  'How do I find diamonds?',
  'How do I build a Nether portal?',
]
---

<Layout title="Minecraft Guide for Jordy" description="Ask Jordy’s Minecraft Guide about crafting, building, and surviving.">
  <main class="minecraft">
    <div class="world-guide">
      <header class="intro">
        <h1>Minecraft<br />{' '}<span>Guide</span></h1>
      </header>

      <section class="chat" aria-labelledby="chat-heading">
        <header class="chat-header">
          <h2 id="chat-heading">Ask the guide</h2>
          <details class="chat-options">
            <summary>
              <span aria-hidden="true">⋯</span>
              <span class="visually-hidden">Chat options</span>
            </summary>
            <div class="options-panel">
              <div class="voice-options">
                <label for="minecraft-voice">AI voice</label>
                <select id="minecraft-voice">
                  {openAISpeechVoices.map(voice => (
                    <option value={voice}>{voice[0].toUpperCase() + voice.slice(1)}</option>
                  ))}
                </select>
              </div>
              <button class="reset" type="button" disabled>New chat</button>
              <div class="starters" role="group" aria-labelledby="minecraft-ideas">
                <p id="minecraft-ideas">Question ideas</p>
                {starterQuestions.map(question => <button type="button">{question}</button>)}
              </div>
            </div>
          </details>
        </header>

        <div class="messages" role="log" aria-label="Conversation" tabindex="0">
          <article class="message guide-message">
            <h3>Guide</h3>
            <p>Hey, Jordy! What are you working on in Minecraft Bedrock on PS5?</p>
          </article>
        </div>

        <form class="composer">
          <p class="feedback" role="status"></p>
          <div class="composer-field">
            <label class="visually-hidden" for="minecraft-question">Your Minecraft question</label>
            <textarea
              id="minecraft-question"
              name="question"
              rows="2"
              maxlength={questionLimit}
              placeholder="Ask about Minecraft…"
              required
            ></textarea>
            <button class="send" type="submit">Send</button>
          </div>
          <noscript><p>Enable JavaScript to chat with the guide.</p></noscript>
        </form>
      </section>
    </div>
  </main>
</Layout>

<script>
  import {historyLimit, type ChatTurn} from '@/core/minecraft/chat'
  import {requestOpenAISpeech} from '@/core/openai/speech'

  const chat = document.querySelector('.chat')
  const log = chat?.querySelector('.messages')
  const starters = chat?.querySelector<HTMLElement>('.starters')
  const form = chat?.querySelector('form')
  const input = chat?.querySelector('textarea')
  const send = chat?.querySelector<HTMLButtonElement>('.send')
  const reset = chat?.querySelector<HTMLButtonElement>('.reset')
  const feedback = chat?.querySelector('.feedback')
  const voice = chat?.querySelector<HTMLSelectElement>('#minecraft-voice')
  const options = chat?.querySelector('details')
  const optionsButton = options?.querySelector('summary')

  if (log && starters && form && input && send && reset && feedback && voice && options && optionsButton) {
    const initialMessage = log.firstElementChild
    const suggestions = Array.from(starters.querySelectorAll('button'))
    const history: ChatTurn[] = []
    const usesNativeSizing = CSS.supports('field-sizing', 'content')

    function resizeQuestion() {
      if (usesNativeSizing) return
      input.style.height = ''
      const borders = input.offsetHeight - input.clientHeight
      input.style.height = `${input.scrollHeight + borders}px`
    }

    if (!usesNativeSizing) {
      input.addEventListener('input', resizeQuestion)
      window.addEventListener('resize', resizeQuestion)
    }

    const voiceKey = 'minecraft-guide.voice'
    const audio = document.createElement('audio')
    audio.controls = true
    audio.className = 'reply-audio'
    audio.setAttribute('aria-label', 'Guide reply audio')
    const voiceStatus = document.createElement('p')
    voiceStatus.className = 'voice-status'
    voiceStatus.setAttribute('role', 'status')

    let playback: {button: HTMLButtonElement; request: AbortController; url: string} | undefined

    try {
      const saved = localStorage.getItem(voiceKey)
      if (saved && Array.from(voice.options).some(option => option.value === saved)) voice.value = saved
    } catch {
      // Voice selection also works with browser storage disabled.
    }

    function stopSpeech() {
      const previous = playback
      playback = undefined
      if (previous) {
        previous.request.abort()
        previous.button.textContent = 'Read aloud'
        audio.pause()
        audio.removeAttribute('src')
        audio.load()
        audio.remove()
        if (previous.url) URL.revokeObjectURL(previous.url)
      }
      voiceStatus.textContent = ''
      voiceStatus.remove()
    }

    async function readReply(button: HTMLButtonElement, text: string) {
      const wasActive = playback?.button === button
      stopSpeech()
      if (wasActive) return

      const request = new AbortController()
      const current = {button, request, url: ''}
      playback = current
      button.textContent = 'Cancel audio'
      button.after(voiceStatus)
      voiceStatus.textContent = 'Loading audio…'
      const timeout = window.setTimeout(() => request.abort(), 30000)

      try {
        const response = await requestOpenAISpeech(text, voice.value, request.signal)
        if (!response.ok || !response.headers.get('Content-Type')?.startsWith('audio/')) {
          throw new Error('Audio unavailable')
        }
        const blob = await response.blob()
        if (playback !== current) return
        current.url = URL.createObjectURL(blob)
        audio.src = current.url
        button.after(audio)
        button.textContent = 'Close audio'
        voiceStatus.textContent = ''
        await audio.play().catch(error => {
          if (error instanceof DOMException && error.name === 'NotAllowedError') {
            if (playback === current) voiceStatus.textContent = 'Press Play to listen.'
            return
          }
          throw error
        })
      } catch {
        if (playback !== current) return
        stopSpeech()
        button.after(voiceStatus)
        voiceStatus.textContent = 'Audio couldn’t play. Try Read aloud again.'
      } finally {
        window.clearTimeout(timeout)
      }
    }

    voice.addEventListener('change', () => {
      stopSpeech()
      try {
        localStorage.setItem(voiceKey, voice.value)
      } catch {
        // Keep the selection for this session.
      }
    })
    window.addEventListener('pagehide', stopSpeech)

    document.addEventListener('click', event => {
      if (event.target instanceof Node && !options.contains(event.target)) options.open = false
    })

    options.addEventListener('keydown', event => {
      if (event.key !== 'Escape' || !options.open) return
      options.open = false
      optionsButton.focus()
    })

    const appendMessage = (speaker: 'Jordy' | 'Guide', text: string) => {
      const message = document.createElement('article')
      message.className = speaker === 'Jordy' ? 'message user-message' : 'message guide-message'
      const name = document.createElement('h3')
      name.textContent = speaker
      const body = document.createElement('p')
      body.textContent = text
      message.append(name, body)
      if (speaker === 'Guide') {
        const read = document.createElement('button')
        read.type = 'button'
        read.className = 'read-reply'
        read.textContent = 'Read aloud'
        read.addEventListener('click', () => void readReply(read, text))
        message.append(read)
      }
      log.append(message)
      log.scrollTop = speaker === 'Guide' ? message.offsetTop : log.scrollHeight
      return message
    }

    async function ask(question: string) {
      if (!question || send.disabled) return
      options.open = false
      input.value = ''
      resizeQuestion()
      input.readOnly = true
      send.disabled = true
      reset.disabled = true
      starters.hidden = true
      feedback.textContent = 'The guide is thinking…'
      const message = appendMessage('Jordy', question)

      try {
        const response = await fetch('/api/openai/minecraft', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({question, history}),
        })
        const result = await response.json()
        if (!response.ok || typeof result.reply !== 'string' || !result.reply) {
          throw new Error('No guide reply')
        }

        appendMessage('Guide', result.reply)
        history.push({question, reply: result.reply})
        if (history.length > historyLimit) history.shift()
        feedback.textContent = ''
      } catch {
        message.remove()
        input.value = question
        resizeQuestion()
        feedback.textContent = 'The guide couldn’t answer. Try sending your question again.'
      } finally {
        input.readOnly = false
        send.disabled = false
        reset.disabled = history.length === 0
        starters.hidden = history.length > 0
      }
    }

    form.addEventListener('submit', event => {
      event.preventDefault()
      void ask(input.value.trim())
    })

    input.addEventListener('keydown', event => {
      if (event.key !== 'Enter' || event.shiftKey || event.isComposing) return
      event.preventDefault()
      if (!send.disabled) form.requestSubmit()
    })

    for (const suggestion of suggestions) {
      suggestion.addEventListener('click', () => {
        input.focus()
        void ask(suggestion.textContent?.trim() ?? '')
      })
    }

    reset.addEventListener('click', () => {
      options.open = false
      stopSpeech()
      history.length = 0
      if (initialMessage) log.replaceChildren(initialMessage)
      feedback.textContent = ''
      input.value = ''
      resizeQuestion()
      starters.hidden = false
      input.focus()
      reset.disabled = true
    })
  }
</script>

<style>
  :global(html:has(.minecraft)) {
    color-scheme: dark;
    background: #10170f;
    --menu-icon-color: #f4f3dd;
    --menu-icon-hover: #c9ec84;
    --pico-color: #f4f3dd;
  }

  .minecraft {
    --ink: #f4f3dd;
    --muted: #c3ccba;
    --lime: #d3ee92;
    --line: #3e4b35;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: clamp(5.25rem, 10vh, 8rem) clamp(1rem, 6vw, 6rem) 3.5rem;
    background:
      linear-gradient(90deg, #12190fe8, #10170f64 54%, #10170f35),
      linear-gradient(0deg, #10170f 0%, transparent 60%),
      #283b28 url('/minecraft-world.webp') center / cover no-repeat;
    color: var(--ink);
  }

  .world-guide {
    width: min(100%, 76rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    align-items: center;
    gap: clamp(1.75rem, 5vw, 5.5rem);
  }

  h1 {
    font: 1000 clamp(2.85rem, 6.2vw, 6.6rem) / 0.94 system-ui, sans-serif;
    letter-spacing: -0.07em;
    text-transform: uppercase;
    text-shadow: 0.055em 0.065em 0 #14200d;
  }

  h1 span { color: var(--lime); }

  .chat {
    min-width: 0;
    background: #171e15;
    border: 2px solid #58624b;
    box-shadow: inset 0 3px 0 #768062, 6px 6px 0 #0b100bd9, 0 20px 60px #10170f75;
  }

  .chat-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.5rem 1.2rem;
    background: #222b1d;
    border-bottom: 2px solid var(--line);
  }

  .chat-header h2 {
    flex: 1;
    font: 700 clamp(1rem, 2.3vw, 1.35rem) / 1.2 ui-monospace, monospace;
  }

  .chat-options { position: relative; }

  .chat-options summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    list-style: none;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
  }

  .chat-options summary::-webkit-details-marker { display: none; }
  .chat-options[open] summary, .chat-options summary:hover { background: #35442b; }

  .options-panel {
    position: absolute;
    z-index: 2;
    inset: calc(100% + 0.25rem) 0 auto auto;
    width: min(16rem, calc(100vw - 3.5rem));
    display: grid;
    gap: 0.6rem;
    padding: 0.75rem;
    background: #222b1d;
    border: 1px solid var(--line);
    box-shadow: 4px 4px #0b100bd9;
    font-size: 0.875rem;
  }

  .voice-options {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    color: var(--muted);
  }

  button, select, textarea { font: inherit; }
  button { cursor: pointer; }
  button:disabled { cursor: default; opacity: 0.6; }

  .options-panel :is(select, button) {
    color: var(--ink);
    border: 1px solid #506142;
    border-radius: 0;
    background: #232d1e;
    padding: 0.4rem 0.6rem;
    text-align: start;
  }

  .options-panel button:not(:disabled):hover { background: #35442b; }

  .messages {
    position: relative;
    height: clamp(13rem, 30vh, 23rem);
    overflow: auto;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .chat:has(.starters[hidden]) .messages {
    height: clamp(17rem, 47vh, 31rem);
  }

  .chat :global(.message) {
    align-self: flex-start;
    flex: none;
    width: fit-content;
    max-width: 92%;
    padding: 0.65rem 0.85rem 0.85rem;
    background: #252e20;
    border-inline-start: 3px solid #9ab95e;
    overflow-wrap: anywhere;
  }

  .chat :global(.user-message) {
    align-self: flex-end;
    background: #313a28;
    border-inline-start-color: #cbb880;
  }

  .chat :global(.message h3) {
    color: var(--lime);
    margin: 0 0 0.25rem;
    font: 700 0.875rem / 1.25 ui-monospace, monospace;
  }

  .chat :global(.user-message h3) { color: #e6d6a6; }
  .chat :global(.message p) { margin: 0; white-space: pre-wrap; }
  .chat :global(.read-reply) {
    margin-top: 0.35rem;
    padding: 0.25rem 0;
    color: var(--muted);
    background: transparent;
    border: 0;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .chat :global(.read-reply:hover) { color: var(--lime); }
  .chat :global(.read-reply:focus-visible) { outline: 2px solid var(--lime); outline-offset: 2px; }
  .chat :global(.reply-audio) { display: block; width: 18rem; max-width: 100%; margin-top: 0.5rem; }
  .chat :global(.voice-status) { color: var(--muted); font-size: 0.875rem; }
  .chat :global(.voice-status:empty) { display: none; }

  .starters {
    display: grid;
    gap: 0.45rem;
    border-top: 1px solid var(--line);
    padding-top: 0.55rem;
  }

  .starters[hidden] { display: none; }
  .starters p { color: var(--muted); }

  .composer {
    border-top: 2px solid var(--line);
    padding: 0.95rem 1.2rem;
  }

  .composer-field {
    --composer-min-height: calc(4rem + 2px);
    display: flex;
    gap: 0.65rem;
    align-items: flex-end;
  }

  textarea {
    display: block;
    width: 100%;
    min-width: 0;
    field-sizing: content;
    min-height: var(--composer-min-height);
    max-height: max(var(--composer-min-height), min(12rem, 28dvh));
    resize: none;
    overflow-y: auto;
    padding: 0.65rem 0.75rem;
    color: var(--ink);
    background: #111711;
    border: 1px solid #677355;
    border-radius: 0;
    line-height: 1.35;
  }

  textarea::placeholder { color: #aab6a3; }

  .send {
    min-height: var(--composer-min-height);
    padding: 0.65rem 1rem;
    font: 800 1rem / 1.25 ui-monospace, monospace;
    color: #18220f;
    background: var(--lime);
    border: 2px solid #a8c871;
    box-shadow: inset 0 -4px #a5c370;
  }

  .send:not(:disabled):hover { background: #e4f8ac; }

  .feedback { color: var(--muted); margin: 0 0 0.65rem; }
  .feedback:empty { margin: 0; }

  :is(textarea, button, select, summary, .messages):focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 2px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .minecraft {
      place-items: start center;
      background-position: center, center, 63% top;
    }

    .world-guide { grid-template-columns: minmax(0, 1fr); }

    h1 { font-size: clamp(2.55rem, 9.2vw, 4.75rem); }
    h1 br { display: none; }
    .messages { height: 9.5rem; }
    .chat:has(.starters[hidden]) .messages { height: clamp(14rem, 37svh, 23rem); }
  }

  @media (max-width: 420px) {
    .chat-header, .messages, .composer { padding-inline: 0.75rem; }
    .send { padding-inline: 0.65rem; }
  }
</style>
