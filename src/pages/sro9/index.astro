---
import Layout from '../../layouts/Layout.astro'
import './_styles.css'
---

<Layout title="SRO9 - Time Left to Time of Day">
  <main>
    <header class="header-section">
      <p class="eyebrow">SRO9</p>
      <h1>Time Left to Time of Day</h1>
      <p class="subtitle">
        Enter how much time is left and discover its time of day.
      </p>
    </header>

    <section class="game-container" aria-labelledby="converter-title">
      <div class="converter-heading">
        <div>
          <p class="step">Choose a version</p>
          <h2 id="converter-title">Time converter</h2>
        </div>
        <label class="version-field" for="boundary-select">
          Boundary version
          <select id="boundary-select" name="boundary">
            <option value="0">Midnight</option>
            <option value="860">2:20 PM</option>
          </select>
        </label>
      </div>

      <div class="mode-panel">
        <div>
          <p class="step">Input mode</p>
          <h3 id="mode-title">Full time</h3>
          <p id="mode-description">Type hours and minutes from 0:00 to 23:59.</p>
        </div>
        <button
          id="mode-switch"
          class="mode-switch is-on"
          type="button"
          role="switch"
          aria-checked="true"
          aria-labelledby="mode-title"
          aria-describedby="mode-description"
        >
          <img src="/lights/light_on2.png" alt="" />
          <span>Switch to hours only</span>
        </button>
      </div>

      <form id="time-form" class="time-form" novalidate>
        <label for="time-input">How much time is left?</label>
        <div class="input-row">
          <input
            id="time-input"
            name="time"
            type="text"
            inputmode="numeric"
            autocomplete="off"
            placeholder="0:00"
            aria-describedby="input-help input-error"
          />
          <button class="submit-btn" type="submit">Show time of day</button>
        </div>
        <p id="input-help">Use a value from 0:00 through 23:59.</p>
        <p id="input-error" class="input-error" aria-live="assertive"></p>
      </form>

      <output id="time-result" class="time-result" aria-live="polite">
        <span>Time of day</span>
        <strong id="time-display">--:--</strong>
      </output>
    </section>
  </main>
</Layout>

<script src="./_main.ts"></script>
