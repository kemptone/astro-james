---
import Empty from '../layouts/Empty.astro'
import WCDialogWrap from '../components/WCDialogWrap.astro'
import Menu3 from '@/components/menu.astro'
import '../../pico.css'
import '../core/talkers2/style.css'
---

<Empty title="talkers">
  <div id="talkers" class="container2">
    <header class="header">
      <div id="brand"></div>
      <div class="buttons">
        <button id="add_sound">Sounds</button>
        <span class="spacer"></span>
        <label class="gap_input">
          Gap %
          <input
            type="number"
            name="gap_percent"
            id="gap_percent"
            min="0"
            max="100"
            step="1"
            placeholder="(blank = off)"
          />
        </label>
        <button id="remove_all">Remove All</button>
        <button id="clear_all">Clear</button>
        <button id="play_all">Play</button>
        <Menu3 />
      </div>
    </header>
    <aside class="leftColumn" id="list">
      <WCDialogWrap id="sounds">
        <div>
          <wc-meme-board>
            <fieldset
              class="sound-mode-filters"
              aria-describedby="sound-mode-help"
            >
              <legend>Show sound types</legend>
              <label>
                <input
                  type="checkbox"
                  name="kid_mode"
                  autocomplete="off"
                  checked
                />
                Kid mode
              </label>
              <label>
                <input
                  type="checkbox"
                  name="adult_mode"
                  autocomplete="off"
                />
                Adult mode
              </label>
              <label>
                <input
                  type="checkbox"
                  name="bad_words_mode"
                  autocomplete="off"
                />
                Bad words (1–40)
              </label>
              <p id="sound-mode-help">
                Choose one or more. Kid is checked clean audio. Adult currently
                means unchecked or unclear audio. Bad words is checked audio
                with rankings 1–40. Turn all three off to show every sound.
                Number searches show their matches regardless of these modes.
              </p>
            </fieldset>
            <fieldset role="group" class="sound-search-filters">
              <input
                type="search"
                placeholder="Name or audio number (1–40; 41 = ranked/unchecked)"
                name="filter"
                aria-label="Filter by sound name or checked-audio bad-word numbers"
              />
              <input
                type="text"
                name="exclude_ranks"
                inputmode="numeric"
                placeholder="Hide numbers: 4, 25, 41"
                aria-label="Hide sounds with these checked-audio numbers"
              />
            </fieldset>
            <div class="sound-ranking-help">
              <p>
                Bad-word numbers use the 40-word ranking: 1 is strongest and
                40 is least. Search numbers separated by commas to show checked
                audio containing any of them. Search 41 to show sounds with at
                least one bad-word number plus sounds whose audio has not been
                checked yet. After an unchecked sound is checked, it stays in
                the 41 list if it has a number and disappears if it is clean.
                The numbers come from the audio, never the sound name, so spoken
                “cow” gets 40 even when it means the animal. Use Hide numbers to
                leave matching sounds out; hiding 41 leaves only checked sounds
                with no ranked words. Inconclusive audio is not included in
                number searches, and automated checks can miss words.
              </p>
              <div class="sound-count-controls">
                <output data-sound-count aria-live="polite">Loading sounds…</output>
                <button type="button" class="show-more-sounds" hidden>
                  Show more
                </button>
              </div>
            </div>
            <div class="list"></div>
          </wc-meme-board>
        </div>
      </WCDialogWrap>
    </aside>
    <form class="rightColumn" id="main_form">
      <div id="input_area"></div>
      <div class="almost_hidden">
        <label>
          <input type="checkbox" name="reversed" checked> desrever
        </label>
      </div>
      <div class="almost_hidden">
        <label>
          <input type="checkbox" name="textreversed"> reverser
        </label>
      </div>
    </form>
  </div>
</Empty>

<script src="../core/talkers2/index.ts"></script>
<script src="../components/wc-meme-board.ts"></script>

<style>
  .almost_hidden {
    opacity: .1;
  }
</style>
